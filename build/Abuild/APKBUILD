pkgname=glib
pkgver=2.86.2
_gi_version=1.86.0
pkgrel=1
pkgdesc="Low-level core library that forms the basis for projects such as GTK+ and GNOME."
arch="all"
license="LGPL-2.1-or-later"
url="https://www.gtk.org/"
triggers="$pkgname.trigger=/usr/share/glib-2.0/schemas:/usr/lib/gio/modules:/usr/lib/gtk-4.0"
depends_dev="
    libffi-dev
    pcre2-dev
    bzip2-dev
    gettext-dev
    zlib-ng-dev
    libxml2-utils
    python3
    python3-packaging
    qnx-io-sock-dev
    libxslt
    "
makedepends="$depends_dev
    bison
    flex
    meson 
    ninja 
    pkgconf
    python3-dev
    pkgconf-dev
    python3-setuptools
    qnx-io-sock-dev
    libiconv-dev
    "
depends="qnx-io-sock libintl bzip2 libbz2 zlib-ng pcre2 libiconv libffi libiconv libexpat libiconv"
options="!strip"

subpackages="${pkgname}-static ${pkgname}-dev ${pkgname}-bash-completion"
source="https://download.gnome.org/sources/glib/${pkgver%.*}/glib-$pkgver.tar.xz
        https://download.gnome.org/sources/gobject-introspection/${_gi_version%.*}/gobject-introspection-$_gi_version.tar.xz
        fix-atomic.patch
        fix-test-symbol-conflicts.patch
	    use-freebsd-gcred.patch
        fix-faccessat-on-QNX.patch
	    fix-printf-null-segfault.patch
    "
builddir="$srcdir/$pkgname-$pkgver"

build() {
    export CFLAGS="$CFLAGS"
    _prefix="$PWD/boostrap-glib"
    msg "build bootstrap glib"
    meson setup build  \
        -Dtests=false \
        -Dxattr=false \
	    -Db_lto=false \
        -Dnls=disabled \
        -Dintrospection=disabled \
        --buildtype=release \
        --prefix=$_prefix \
	-Dc_link_args=-Wl,-lsocket,-lm,-lgcc_s
    meson compile -C build
    meson install --no-rebuild -C build

    msg "build bootstrap gobject-introspection"
    cd $srcdir/gobject-introspection-$_gi_version
    meson setup build \
        -Dcairo=disabled \
        -Dbuild_introspection_data=false \
	    -Db_lto=false \
        --buildtype=release \
        --prefix=$_prefix \
        --pkg-config-path="$_prefix"/lib/pkgconfig \
        -Dc_link_args=-Wl,-lsocket,-lm
    meson compile -C build
    meson install --no-rebuild -C build

    msg "build final glib"
    cd $builddir
    PATH="$_prefix/bin:$PATH" LD_LIBRARY_PATH="$_prefix/lib:$LD_LIBRARY_PATH" \
    meson setup build \
        --reconfigure \
        -Dtests=false \
        -Dxattr=false \
	    -Db_lto=false \
        -Dnls=disabled \
        -Ddefault_library=both \
        -Dintrospection=enabled \
        --buildtype=release \
        --prefix=/usr \
        --pkg-config-path="$_prefix"/lib/pkgconfig \
        -Dc_link_args=-Wl,-lsocket,-lm,-lgcc_s

    PATH="$_prefix/bin:$PATH" LD_LIBRARY_PATH="$_prefix/lib:$LD_LIBRARY_PATH" \
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

dev() {
    default_dev
    mkdir -p "$subpkgdir"/usr/bin "$subpkgdir"/usr/share
    find "$pkgdir"/usr/bin ! -name "glib-compile-schemas" -a \( \
        -name "gdbus-codegen" -o \
        -name "gobject-query" -o \
        -name "gresource" -o \
        -name "gtester*" -o \
        -name "glib-*" \) \
        -exec mv {} "$subpkgdir"/usr/bin \;

    amove usr/share/gdb usr/share/glib-2.0
}

static() {
    default_static
    depends="gettext-static"

}

check() {
    # not all tests are passed for now, just an experimental build
    meson test --print-errorlogs -C build
}

